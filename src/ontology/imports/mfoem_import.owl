# Class: obo:IAO_0000409 (denotator type)

AnnotationAssertion(obo:IAO_0000111 obo:IAO_0000409 "denotator type"@en)
AnnotationAssertion(obo:IAO_0000112 obo:IAO_0000409 "The Basic Formal Ontology ontology makes a distinction between Universals and defined classes, where the formal are \"natural kinds\" and the latter arbitrary collections of entities.")
AnnotationAssertion(obo:IAO_0000112 obo:IAO_0000409 "The Basic Formal Ontology ontology makes a distinction between Universals and defined classes, where the formal are \"natural kinds\" and the latter arbitrary collections of entities."@en)
AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000409 "A denotator type indicates how a term should be interpreted from an ontological perspective.")
AnnotationAssertion(obo:IAO_0000115 obo:IAO_0000409 "A denotator type indicates how a term should be interpreted from an ontological perspective."@en)
AnnotationAssertion(obo:IAO_0000117 obo:IAO_0000409 "Alan Ruttenberg")
AnnotationAssertion(obo:IAO_0000117 obo:IAO_0000409 "Alan Ruttenberg"@en)
AnnotationAssertion(rdfs:label obo:IAO_0000409 "denotator type")
AnnotationAssertion(rdfs:label obo:IAO_0000409 "denotator type"@en)
EquivalentClasses(obo:IAO_0000409 ObjectOneOf(obo:IAO_0000410 obo:IAO_0000420 obo:IAO_0000421))
SubClassOf(obo:IAO_0000409 obo:IAO_0000102)

# Class: obo:MFOEM_000001 (emotion process)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000001 "An affective process that is a synchronized aggregate of constituent mental processes including an appraisal process, which is valenced, has an object, and gives rise to an action tendency.")
AnnotationAssertion(rdfs:comment obo:MFOEM_000001 "Emotion processes are distinguished from other affective processes (e.g., mood) by having an object. Even if an emotion is experienced due to physiological reasons, they would be felt as being about something or someone. For instance, a person might be angry at a situation that they would normally not be angry at, because they are hungry. However, that person would still be angry at a specific situation.")
AnnotationAssertion(rdfs:comment obo:MFOEM_000001 "There is no rigid sequence of the entities that are part of the emotion process (e.g., an appraisal process does not necessarily precede a physiological process part of the emotion process).")
AnnotationAssertion(rdfs:comment obo:MFOEM_000001 "Valence refers to the 'the subjective value of an event, object, person, or other entity in the life space of the individual' (https://dictionary.apa.org/valence). Valence ranges from negative to positive.")
AnnotationAssertion(rdfs:label obo:MFOEM_000001 "emotion process")
SubClassOf(obo:MFOEM_000001 obo:MFOEM_000195)
SubClassOf(obo:MFOEM_000001 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/MF#hasAgent> obo:OGMS_0000087))
SubClassOf(obo:MFOEM_000001 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/MF#hasPart> obo:MFOEM_000002))
SubClassOf(obo:MFOEM_000001 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/MF#hasPart> obo:MFOEM_000003))
SubClassOf(obo:MFOEM_000001 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/MF#hasPart> obo:MFOEM_000004))
SubClassOf(obo:MFOEM_000001 ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/MF#hasPart> obo:MFOEM_000006))

# Class: obo:MFOEM_000002 (affective appraisal process)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000002 "A mental process that gives rise to an appraisal.")
AnnotationAssertion(rdfs:label obo:MFOEM_000002 "affective appraisal process")
SubClassOf(obo:MFOEM_000002 obo:MF_0000020)
SubClassOf(obo:MFOEM_000002 ObjectSomeValuesFrom(obo:BFO_0000132 obo:MFOEM_000001))

# Class: obo:MFOEM_000003 (physiological process involved in an emotion)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000003 "A bodily process that encompasses all the neurophysiological changes accompanying an emotion, which take place in the central nervous system (CNS), neuro-endocrine system (NES) and autonomous nervous system (ANS).")
AnnotationAssertion(rdfs:label obo:MFOEM_000003 "physiological process involved in an emotion")
SubClassOf(obo:MFOEM_000003 obo:OGMS_0000060)

# Class: obo:MFOEM_000004 (emotional behavioural process)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000004 "An emotional behavioural process is the behaviour of the organism in response to the appraisal, which includes the characteristic facial expressions for particular emotion types.")
AnnotationAssertion(rdfs:comment obo:MFOEM_000004 "This branch is still very much under construction and will be worked on in collaboration with the Behaviour Ontology (George Gkoutos). ")
AnnotationAssertion(rdfs:label obo:MFOEM_000004 "emotional behavioural process")
SubClassOf(obo:MFOEM_000004 obo:GO_0007610)

# Class: obo:MFOEM_000006 (subjective affective feeling)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000006 "An affective process that involves the experience of internal or external sensory stimuli.")
AnnotationAssertion(rdfs:comment obo:MFOEM_000006 "As a subclass of 'affective process', subjective affective feelings have valence. Valence refers to the 'the subjective value of an event, object, person, or other entity in the life space of the individual' (https://dictionary.apa.org/valence). Valence ranges from negative to positive.")
AnnotationAssertion(rdfs:comment obo:MFOEM_000006 "Bodily sensations and the experiences of emotions (e.g., feeling calm) would both qualify as examples of 'subjective affective feeling'.")
AnnotationAssertion(rdfs:comment obo:MFOEM_000006 "Excluded the following subjective feelings which appear on the GRID questionnaire since they seem debatable to what extent they are really *feelings* and to what extent they are actually *evaluations* or other things:

-- felt submissive/dominant
-- felt powerless/powerful



")
AnnotationAssertion(rdfs:comment obo:MFOEM_000006 "Subjective affective feeling can have greater or weaker physiological or mental components. The bodily processes that are experienced will usually involve some mental process.")
AnnotationAssertion(rdfs:label obo:MFOEM_000006 "subjective affective feeling")
SubClassOf(obo:MFOEM_000006 obo:MFOEM_000195)

# Class: obo:MFOEM_000080 (feeling tired)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000080 "A subjective affective feeling of a need for sleep.")
AnnotationAssertion(rdfs:label obo:MFOEM_000080 "feeling tired")
SubClassOf(obo:MFOEM_000080 obo:MFOEM_000006)

# Class: obo:MFOEM_000112 (feeling exhausted)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000112 "Feeling tired to an extremely strong degree.")
AnnotationAssertion(rdfs:label obo:MFOEM_000112 "feeling exhausted")
SubClassOf(obo:MFOEM_000112 obo:MFOEM_000080)

# Class: obo:MFOEM_000193 (mood process)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000193 "A mood process is a mental process that involves affect (is valenced), and gives rise to a number of behavioural dispositions, but unlike an emotion has no object. Moods are usually longer-lived than emotion processes, but there are exceptions.")
AnnotationAssertion(rdfs:comment obo:MFOEM_000193 "Moods are more difficult to individuate into types than emotions. We may speak of a good mood, a bad mood, or suchlike. We may also speak of being in an angry mood or other moods which take their identity from emotions. These often accompany a heightened disposition to undergo the emotion they are named for. ")
AnnotationAssertion(rdfs:label obo:MFOEM_000193 "mood process"@en)
SubClassOf(obo:MFOEM_000193 obo:MFOEM_000195)

# Class: obo:MFOEM_000194 (valence)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000194 "Valence is a process profile of an emotion, mood, or affective bodily feeling (such as pleasure and pain). Valence can be positive or negative, with different strengths in both directions. For example, pleasure is positively valenced while pain is negatively valenced.")
AnnotationAssertion(rdfs:label obo:MFOEM_000194 "valence"@en)
SubClassOf(obo:MFOEM_000194 obo:BFO_0000144)

# Class: obo:MFOEM_000195 (affective process)

AnnotationAssertion(obo:IAO_0000115 obo:MFOEM_000195 "A mental process that has positive or negative valence.")
AnnotationAssertion(rdfs:label obo:MFOEM_000195 "affective process"@en)
EquivalentClasses(obo:MFOEM_000195 ObjectIntersectionOf(obo:MF_0000020 ObjectSomeValuesFrom(ObjectInverseOf(obo:BFO_0000133) obo:MFOEM_000194)))
SubClassOf(obo:MFOEM_000195 obo:MF_0000020)

# Class: obo:MF_0000008 (cognitive process)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000008 "A mental process that creates, modifies or has as participant some cognitive representation.")
AnnotationAssertion(rdfs:label obo:MF_0000008 "cognitive process")
SubClassOf(obo:MF_0000008 obo:MF_0000020)
SubClassOf(obo:MF_0000008 ObjectSomeValuesFrom(obo:BFO_0000167 obo:MF_0000031))

# Class: obo:MF_0000017 (consciousness)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000017 "Consciousness is an inseparable part of some mental processes. It is that part of the mental process that: a) confers a subjective perspective, a phenomenology, an experience of the mental process of which it is a part; and b) intends the object or event that the mental process is about, should such exist; i.e., it confers intentionality on the mental process.")
AnnotationAssertion(rdfs:comment obo:MF_0000017 "Note that while there are different modes of consciousness corresponding to the different senses, the whole of conscious experience at any one time is largely experienced as a unity, that is, as a fused whole. Mental processes which are simultaneously ongoing are separable only in fiat, not in essence. ")
AnnotationAssertion(rdfs:label obo:MF_0000017 "consciousness"@en)
SubClassOf(obo:MF_0000017 obo:BFO_0000144)
SubClassOf(obo:MF_0000017 ObjectSomeValuesFrom(obo:BFO_0000055 obo:MF_0000076))
SubClassOf(obo:MF_0000017 ObjectSomeValuesFrom(obo:BFO_0000132 ObjectIntersectionOf(obo:MF_0000020 ObjectComplementOf(obo:MF_0000017))))
SubClassOf(obo:MF_0000017 ObjectSomeValuesFrom(obo:BFO_0000167 obo:MF_0000073))

# Class: obo:MF_0000020 (mental process)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000020 "A bodily process that occurs in the brain, and that can of itself be conscious, or can give rise to a process that can of itself be conscious or can give rise to behaviour.")
AnnotationAssertion(rdfs:comment obo:MF_0000020 "A 'mental process' is a subclass of 'bodily process', as mental processes occur within the body, specifically involving the brain.")
AnnotationAssertion(rdfs:comment obo:MF_0000020 "A bodily process which brings into being, sustains or modifies a cognitive representation or a behavior inducing state.")
AnnotationAssertion(rdfs:comment obo:MF_0000020 "Examples include thinking, feeling pain, remembering and emotion as occurrent experiences.")
AnnotationAssertion(rdfs:comment obo:MF_0000020 "Mental processes can varying in the degree to which they involve consciousness.")
AnnotationAssertion(rdfs:label obo:MF_0000020 "mental process")
SubClassOf(obo:MF_0000020 obo:OGMS_0000060)
SubClassOf(obo:MF_0000020 ObjectSomeValuesFrom(obo:BFO_0000055 obo:MF_0000033))
SubClassOf(obo:MF_0000020 ObjectSomeValuesFrom(obo:BFO_0000117 obo:MF_0000017))

# Class: obo:MF_0000022 (agreeableness)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000022 "A personality trait manifesting itself in individual behavioral characteristics that are perceived as kind, sympathetic, cooperative, warm, and considerate."@en)
AnnotationAssertion(rdfs:comment obo:MF_0000022 "Associated adjectives: appreciative, forgiving, generous, kind, sympathetic, and trusting."@en)
AnnotationAssertion(rdfs:label obo:MF_0000022 "agreeableness"@en)
SubClassOf(obo:MF_0000022 obo:MF_0000203)

# Class: obo:MF_0000030 (representation)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000030 "A dependent continuant which is about a portion of reality.")
AnnotationAssertion(rdfs:label obo:MF_0000030 "representation")
SubClassOf(obo:MF_0000030 obo:BFO_0000020)

# Class: obo:MF_0000031 (cognitive representation)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000031 "A representation which specifically depends on an anatomical structure in the cognitive system of an organism.")
AnnotationAssertion(rdfs:comment obo:MF_0000031 "When a belief is activated, the content of that belief is a cognitive representation.

The use of the phrase ‘an anatomical structure in the cognitive system’ in the formal definition means that a specific cognitive representation will depend on parts of the brain, rather than involving the whole brain.")
AnnotationAssertion(rdfs:label obo:MF_0000031 "cognitive representation")
SubClassOf(obo:MF_0000031 obo:MF_0000030)

# Class: obo:MF_0000032 (bodily disposition)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000032 "A bodily disposition is a disposition that inheres in some extended organism. Examples are: my disposition to catch a cold when exposed to a virus, my ability to speak the English language.")
AnnotationAssertion(rdfs:comment obo:MF_0000032 "Bodily disposition includes features that can be used in a specific context, such as a person's strength, but not a person's weight. A person has a specific weight independent of the circumstances they are in.")
AnnotationAssertion(rdfs:comment obo:MF_0000032 "Extended organism refers to an organism and its microbiome (e.g., the bacteria that live in one's digestive system).")
AnnotationAssertion(rdfs:label obo:MF_0000032 "bodily disposition"@en)
EquivalentClasses(obo:MF_0000032 ObjectSomeValuesFrom(obo:BFO_0000052 obo:OGMS_0000087))
SubClassOf(obo:MF_0000032 obo:BFO_0000016)

# Class: obo:MF_0000033 (mental disposition)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000033 "A mental disposition is a bodily disposition that is realized in a mental process. ")
AnnotationAssertion(rdfs:comment obo:MF_0000033 "'Mental disposition' is a subclass of 'bodily disposition', as mental dispositions occur in the body.")
AnnotationAssertion(rdfs:label obo:MF_0000033 "mental disposition"@en)
SubClassOf(obo:MF_0000033 obo:MF_0000032)
SubClassOf(obo:MF_0000033 ObjectAllValuesFrom(obo:BFO_0000054 obo:MF_0000020))

# Class: obo:MF_0000073 (intentionality)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000073 "Intentionality is the fundamental quality of conscious mental processes of always having content, of being directed towards, or about something.")
AnnotationAssertion(rdfs:label obo:MF_0000073 "intentionality"@en)
SubClassOf(obo:MF_0000073 obo:MF_0000075)

# Class: obo:MF_0000074 (bodily quality)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000074 "A bodily quality is a quality that inheres in some extended organism.")
AnnotationAssertion(rdfs:label obo:MF_0000074 "bodily quality"@en)
SubClassOf(obo:MF_0000074 obo:BFO_0000019)

# Class: obo:MF_0000075 (mental quality)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000075 "A mental quality is a bodily quality that inheres in those structures of the extended organism that are essential for mental functioning.")
AnnotationAssertion(rdfs:label obo:MF_0000075 "mental quality"@en)
SubClassOf(obo:MF_0000075 obo:MF_0000074)

# Class: obo:MF_0000076 (intentional modality)

AnnotationAssertion(obo:IAO_0000112 obo:MF_0000076 "An example of an intentional modality is the capacity to represent objects of intentionality as unfolding in time or being time contingent.")
AnnotationAssertion(obo:IAO_0000115 obo:MF_0000076 "A structural capacity that shapes how an object of intentionality is represented for the subject.")
AnnotationAssertion(rdfs:label obo:MF_0000076 "intentional modality"@en)
SubClassOf(obo:MF_0000076 obo:MF_0000033)

# Class: obo:MF_0000202 (personality)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000202 "A bodily disposition that is an aggregate of complex dispositions, endures over a period of years and is realised as emotion, belief, mood, motivational processes or behaviour.")
AnnotationAssertion(rdfs:comment obo:MF_0000202 "Personality is not the same as mood, although a person may have a personality that includes a predisposition to moods of certain types, moods may come and go but a personality stays relatively constant, not appearing and disappearing. Personality typically changes slowly over time.")
AnnotationAssertion(rdfs:comment obo:MF_0000202 "This class is intended to be broad enough to capture all the main personality constructs, including trait theories, type theories, and biopsychosocial theories.")
AnnotationAssertion(rdfs:label obo:MF_0000202 "personality"@en)
SubClassOf(obo:MF_0000202 obo:MF_0000032)

# Class: obo:MF_0000203 (personality trait)

AnnotationAssertion(obo:IAO_0000115 obo:MF_0000203 "A personality trait is an individual disposition or predisposition that forms part of an overall personality and is realized in repeated occurrences of a specific mental process type or behavioural profile. ")
AnnotationAssertion(rdfs:label obo:MF_0000203 "personality trait"@en)
SubClassOf(obo:MF_0000203 obo:MF_0000032)
SubClassOf(obo:MF_0000203 ObjectSomeValuesFrom(obo:BFO_0000176 obo:MF_0000202))

# Class: obo:OGMS_0000060 (bodily process)

AnnotationAssertion(obo:IAO_0000115 obo:OGMS_0000060 "A process in which at least one bodily component of an organsim participates.")
AnnotationAssertion(rdfs:comment obo:OGMS_0000060 "From OGMS: http://purl.obolibrary.org/obo/OGMS_0000060")
AnnotationAssertion(rdfs:label obo:OGMS_0000060 "bodily process")
SubClassOf(obo:OGMS_0000060 obo:BFO_0000015)
SubClassOf(obo:OGMS_0000060 ObjectSomeValuesFrom(obo:BFO_0000167 obo:OGMS_0000087))

# Class: obo:OGMS_0000087 (extended organism)

AnnotationAssertion(rdfs:comment obo:OGMS_0000087 "From OGMS: http://purl.obolibrary.org/obo/OGMS_0000087")
AnnotationAssertion(rdfs:label obo:OGMS_0000087 "extended organism")
SubClassOf(obo:OGMS_0000087 obo:BFO_0000040)

# Class: oboInOwl:Subset (oboInOwl:Subset)

EquivalentClasses(oboInOwl:Subset ObjectOneOf(obo:IAO_0000224))
SubClassOf(oboInOwl:Subset obo:IAO_0000102)


